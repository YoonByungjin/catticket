# Editor defaults so new files are created with LF and consistent indentation
# (VS Code: install the "EditorConfig for VS Code" extension).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,html,css,scss,ts,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

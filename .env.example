# Copy this file to .env and fill in real values. .env is never committed.
# Read by docker compose (MySQL) and by Spring Boot (application.yml imports it).

# MySQL (compose.yaml creates the database and app user from these)
DB_NAME=catticket
DB_USER=catticket
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# 127.0.0.1 when Spring Boot runs on this PC; compose sets it to "db" inside containers
DB_HOST=127.0.0.1
DB_PORT=3306
# Test DB used by ./gradlew test. Leave empty: each git worktree then gets its own
# test_catticket_{folder} automatically (main checkout and CI: test_catticket).
# Override only if needed: test_catticket or test_catticket_{a-z0-9}. Do not set it in
# the main checkout's .env, because Orca copies that file into every worktree.
TEST_DB_NAME=

# KOPIS Open API key (https://www.kopis.or.kr). Server-side only: it is sent over plain http.
KOPIS_API_KEY=

# Azure AI Translator (ADR 0007). Region: leave empty for a global resource.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# reCAPTCHA Enterprise (ADR 0011). The API key is server-side only; never expose it to the frontend.
# The site key is also set in the frontend build settings.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SITE_KEY=

# Gmail SMTP (ADR 0012). MAIL_USERNAME is also the From address. Use a Gmail app password.
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Public URL used in links inside emails (ADR 0010). Default http://localhost:4200; uncomment to change
# (an empty value would override the default).
# CATTICKET_PUBLIC_BASE_URL=

# Only for the B-03 batch (create the admin account). Remove the values after running it.
CATTICKET_ADMIN_EMAIL=
CATTICKET_ADMIN_PASSWORD=

# Session cookie Secure flag (default true). Uncomment with false only for local http; keep it unset in production.
# SESSION_COOKIE_SECURE=false

# Copy this file to .env and fill in real values. .env is never committed.
# Read by docker compose (MySQL) and by Spring Boot (application.yml imports it).

# MySQL (compose.yaml creates the database and app user from these)
DB_NAME=catticket
DB_USER=catticket
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# 127.0.0.1 when Spring Boot runs on this PC; compose sets it to "db" inside containers
DB_HOST=127.0.0.1
DB_PORT=3306
# Test DB used by ./gradlew test. Empty -> test_catticket. To run tests in several
# worktrees at once, give each worktree's .env its own name: test_catticket_{a-z0-9}
# (e.g. TEST_DB_NAME=test_catticket_wt1). Never the development DB.
TEST_DB_NAME=

# KOPIS Open API key (https://www.kopis.or.kr). Server-side only: it is sent over plain http.
KOPIS_API_KEY=

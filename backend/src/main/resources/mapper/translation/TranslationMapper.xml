<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.catticket.translation.TranslationMapper">

  <resultMap id="translationRow" type="com.catticket.translation.row.TranslationRow">
    <constructor>
      <arg column="source_hash" name="sourceHash" javaType="java.lang.String"/>
      <arg column="translated_text" name="translatedText" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <select id="findByHashes" resultMap="translationRow">
    SELECT source_hash, translated_text FROM translation
    WHERE source_hash IN
    <foreach collection="hashes" item="h" open="(" separator="," close=")">#{h}</foreach>
  </select>

</mapper>
